{
  "name": "@lobstack-ai/mcp",
  "version": "0.2.0",
  "mcpName": "io.github.Lobstack-ai/lobstack-mcp",
  "description": "The Lobstack API over MCP: chat, embeddings and web search on one key, and what each call cost.",
  "type": "module",
  "bin": {
    "lobstack-mcp": "./dist/index.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "google",
    "xai",
    "claude",
    "cursor",
    "embeddings",
    "web-search",
    "lobstack",
    "lobstack-api"
  ],
  "license": "MIT",
  "author": "Lobstack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lobstack-ai/lobstack-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Lobstack-ai/lobstack-mcp/issues"
  },
  "homepage": "https://www.lobstack.ai/docs/mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
